# Copiez ce fichier en .env et définissez les clés nécessaires
# OpenWeatherMap (inscription gratuite)
OPENWEATHER_API_KEY=

# Strava (création d'une application et génération d'un token)
STRAVA_TOKEN=

# Ollama CLI (si vous utilisez un modèle local via ollama)
OLLAMA_CMD=ollama

# IGN: si vous avez une clé/API, définissez IGN_API_KEY
IGN_API_KEY=
